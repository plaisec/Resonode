# Resonode — environment configuration.
# Copy this file to ".env" and fill in your values.

# Required: your Discord bot token from the Developer Portal.
DISCORD_TOKEN=put-your-bot-token-here

# (Legacy) Command prefix — unused now that Resonode uses slash commands.
COMMAND_PREFIX=!

# --- Speech-to-text --------------------------------------------------------
# Engine: "local" (faster-whisper: private, free) or "deepgram" (cloud, paid).
RESONODE_STT=local
# Local Whisper model: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# "cpu" (default, works everywhere) or "cuda" for an NVIDIA GPU.
WHISPER_DEVICE=cpu
# Pin the transcription language (ISO code, e.g. "en"). Whisper's auto-detect
# can misfire on short clips (random French!); pin this if your server speaks
# one language. Blank = auto-detect.
RESONODE_STT_LANGUAGE=en
# Only needed if RESONODE_STT=deepgram
# DEEPGRAM_API_KEY=

# --- LLM (summaries, translation, moderation, ask) -------------------------
# Provider: "none" (default), "openai", or "anthropic". Bring your own key.
RESONODE_LLM=none
# RESONODE_LLM_MODEL=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Memory ("server brain") -----------------------------------------------
# "keyword" recall works out of the box. "vector" enables semantic RAG recall
# for /ask (pip install fastembed; the model downloads once on first use).
RESONODE_MEMORY=keyword
# Embeddings for vector memory: "local" (fastembed: private, free) or "openai".
# RESONODE_EMBEDDINGS=local
# Model override (defaults: BAAI/bge-small-en-v1.5 local, text-embedding-3-small openai).
# RESONODE_EMBED_MODEL=

# --- Feature flags ---------------------------------------------------------
# Near-real-time streaming transcription (prototype; off by default).
RESONODE_STREAMING=false
# Auto-post a summary after each session (needs an LLM configured).
RESONODE_AUTO_SUMMARY=false

# --- Streaming tuning (only used when RESONODE_STREAMING=true) --------------
# Flush a speaker's buffer this many ms after they go quiet.
# RESONODE_STREAM_IDLE_MS=700
# Energy (RMS) below this counts as silence; raise it in noisy channels.
# RESONODE_VAD_SILENCE_RMS=500
# Pause length (ms) that closes an utterance.
# RESONODE_VAD_MIN_SILENCE_MS=600
# Ignore voice blips shorter than this (ms).
# RESONODE_VAD_MIN_UTTERANCE_MS=400
# Force-flush monologues longer than this (ms).
# RESONODE_VAD_MAX_UTTERANCE_MS=15000

# --- Testing ---------------------------------------------------------------
# Optional: a server (guild) ID where slash commands register instantly.
# Leave blank for global commands (which can take up to ~1 hour to appear).
RESONODE_DEV_GUILD=
